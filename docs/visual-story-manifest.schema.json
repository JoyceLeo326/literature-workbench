{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文径第二轮视觉故事清单",
  "type": "object",
  "required": ["project", "version", "assets"],
  "properties": {
    "project": { "const": "literature-workbench" },
    "version": { "const": 3 },
    "visualLanguage": { "type": "string", "minLength": 20 },
    "assets": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "file", "person", "situation", "action", "productState", "outcome", "alt", "prompt", "usedIn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "file": { "type": "string", "pattern": "\\.webp$" },
          "person": { "type": "string", "minLength": 2 },
          "situation": { "type": "string", "minLength": 8 },
          "action": { "type": "string", "minLength": 4 },
          "productState": { "type": "string", "minLength": 3 },
          "outcome": { "type": "string", "minLength": 5 },
          "alt": { "type": "string", "minLength": 8 },
          "prompt": { "type": "string", "minLength": 40 },
          "usedIn": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
